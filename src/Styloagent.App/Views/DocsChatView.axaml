<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Styloagent.App.ViewModels"
             xmlns:rag="using:Styloagent.Core.Retrieval"
             xmlns:lucid="clr-namespace:Mostlylucid.LucidView.Markdown;assembly=Mostlylucid.LucidView.Markdown"
             x:Class="Styloagent.App.Views.DocsChatView"
             x:DataType="vm:DocsChatViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="18,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Padding="18,6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Expander Header="Search scope" IsExpanded="False" FontSize="11"
                Foreground="{DynamicResource MutedTextBrush}">
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Sources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SourceToggle">
              <CheckBox Margin="0,0,12,2" Content="{Binding Label}"
                        IsChecked="{Binding IsChecked}" FontSize="11"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Border>
    <ScrollViewer Grid.Row="2" Margin="18,14" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DocsChatMessage">
          <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
            <Border Grid.Column="0" MaxWidth="760" HorizontalAlignment="Left" Padding="12,9" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding !IsUser}">
              <StackPanel Spacing="7">
                <TextBlock Text="Docs assistant" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <lucid:LucidMarkdownView Markdown="{Binding Text}" Foreground="{DynamicResource PrimaryTextBrush}" />
                <ItemsControl ItemsSource="{Binding Sources}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="rag:ContextHit">
                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" MaxWidth="620" HorizontalAlignment="Right" Padding="12,9" CornerRadius="10"
                    Background="#213452" IsVisible="{Binding IsUser}">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" Padding="14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="QuestionBox" Text="{Binding Draft}" Watermark="Ask about the docs…"
                 IsEnabled="{Binding !IsThinking}" KeyDown="OnQuestionKeyDown"/>
        <ProgressBar Grid.Column="1" Width="42" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                     IsVisible="{Binding IsThinking}" ToolTip.Tip="Searching and synthesizing…"/>
        <Button Grid.Column="2" Command="{Binding SendCommand}" Content="Send"
                IsEnabled="{Binding IsReady}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
