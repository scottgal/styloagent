<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Styloagent.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:conv="clr-namespace:Styloagent.App.Converters"
             x:Class="Styloagent.App.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
  <Border Background="{DynamicResource CockpitBgBrush}" Padding="28">
    <!-- Keep the modal itself fixed; only the potentially long Recent folder list scrolls. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" VerticalAlignment="Top"
          HorizontalAlignment="Center" Width="460" MaxWidth="460">
      <StackPanel Grid.Row="0" Spacing="10">
        <Image Source="avares://Styloagent.App/icon.png" Width="64" Height="64"
               HorizontalAlignment="Center" Stretch="Uniform" />
        <TextBlock FontSize="24" HorizontalAlignment="Center">
          <Run Text="stylo" FontWeight="Bold" FontStyle="Italic" Foreground="#DDDDDD" /><Run Text="agent" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
        </TextBlock>
      </StackPanel>

      <!-- New system: scope from a one-line goal; the architect agent figures out the shape. -->
      <StackPanel Grid.Row="1" Spacing="14">
      <TextBlock Text="New system" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                 LetterSpacing="1" Margin="0,6,0,0" />
      <TextBox Watermark="Build a system like X which does Y…"
               Text="{Binding NewSystemDescription}"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
      <Button Content="Create new system →" Command="{Binding NewSystemCommand}"
              Padding="14,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="2" Background="#151528" BorderBrush="#2B2B45" BorderThickness="1" CornerRadius="8"
              Padding="14" Margin="0,14,0,0">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="Default agent runtime" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" LetterSpacing="1" />
            <TextBlock Text="New agents start with this runtime and its models." FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
          <UniformGrid Columns="2" Rows="2" ColumnSpacing="8" RowSpacing="8">
            <ToggleButton x:Name="ClaudeFirstToggle"
                          IsChecked="{Binding IsClaudeFirst, Mode=TwoWay}"
                          Command="{Binding SetRuntimeModeCommand}" CommandParameter="Claude"
                          Padding="12,10" CornerRadius="6" HorizontalContentAlignment="Stretch"
                          ToolTip.Tip="Claude (Anthropic) — Sonnet / Opus">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ic:SymbolIcon Symbol="Sparkle" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="Claude" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="Anthropic · Sonnet / Opus" FontSize="10.5"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="CodexFirstToggle"
                          IsChecked="{Binding IsCodexFirst, Mode=TwoWay}"
                          Command="{Binding SetRuntimeModeCommand}" CommandParameter="Codex"
                          Padding="12,10" CornerRadius="6" HorizontalContentAlignment="Stretch"
                          ToolTip.Tip="Codex (OpenAI) — GPT-5 Codex">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ic:SymbolIcon Symbol="BotSparkle" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="Codex" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="OpenAI · GPT-5 Codex" FontSize="10.5"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="KiloFirstToggle"
                          IsChecked="{Binding IsKiloFirst, Mode=TwoWay}"
                          Command="{Binding SetRuntimeModeCommand}" CommandParameter="Kilo"
                          Padding="12,10" CornerRadius="6" HorizontalContentAlignment="Stretch"
                          ToolTip.Tip="Kilo (DeepSeek) — V4 Pro overviews, V4 Flash specialists">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ic:SymbolIcon Symbol="Rocket" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="Kilo" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="DeepSeek · V4 Pro / Flash" FontSize="10.5"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ClaudeDeepSeekFirstToggle"
                          IsChecked="{Binding IsClaudeDeepSeekFirst, Mode=TwoWay}"
                          Command="{Binding SetRuntimeModeCommand}" CommandParameter="ClaudeDeepSeek"
                          Padding="12,10" CornerRadius="6" HorizontalContentAlignment="Stretch"
                          ToolTip.Tip="Claude Code routed through DeepSeek models">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ic:SymbolIcon Symbol="Cloud" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Spacing="1">
                  <TextBlock Text="Claude + DS" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="Claude Code · DeepSeek" FontSize="10.5"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
            </ToggleButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Height="1" Background="#222226" Margin="0,10" />

      <!-- Open existing project. -->
      <StackPanel Grid.Row="4" Spacing="8">
        <TextBlock Text="Open existing" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                   LetterSpacing="1" />
        <Button Content="Open a project folder…" Command="{Binding OpenFolderCommand}"
                Padding="14,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <TextBlock Text="Recent" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                 IsVisible="{Binding Recent.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}" />
      </StackPanel>
      <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding Recent}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"
                    Background="#151528" BorderThickness="0"
                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
              <TextBlock Text="{Binding}" Foreground="#CCCCDD" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
