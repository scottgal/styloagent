<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Styloagent.App.ViewModels"
             xmlns:views="clr-namespace:Styloagent.App.Views"
             xmlns:git="clr-namespace:Styloagent.Core.Git;assembly=Styloagent.Core"
             x:Class="Styloagent.App.Views.ChangesView"
             x:DataType="vm:ChangesViewModel">

  <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="4">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

      <StackPanel Grid.Row="0" Spacing="4" Margin="6,4">
        <TextBlock Text="{Binding CurrentBranch, StringFormat='Branch: {0}'}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="{Binding SyncSummary}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="{Binding RepositoryPath}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RepositoryPath}" />
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding WriteStatus}" TextWrapping="Wrap" FontSize="11" />
            <TextBlock Text="{Binding WriteError}" IsVisible="{Binding HasWriteError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AttentionBrush}" />
          </StackPanel>
        <!-- Push / Pull row -->
        <StackPanel IsEnabled="{Binding CanWrite}" Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="6,4,6,0">
          <Button Content="Push"
                  FontSize="11" Padding="8,4"
                  Command="{Binding PushCommand}" />
          <Button Content="Pull"
                  FontSize="11" Padding="8,4"
                  Command="{Binding PullCommand}" />
        </StackPanel>

        <!-- Release/tag flow: suggestion follows the existing vX.Y.Z or X.Y.Z convention. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="5" Margin="6,4,6,0"
              IsVisible="{Binding HasTagging}" IsEnabled="{Binding CanWrite}">
          <TextBlock Grid.ColumnSpan="2" Text="Release tag at HEAD" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBox Grid.Row="1" Text="{Binding SuggestedTag}" Watermark="v1.2.3" FontSize="11" Padding="5,2" />
          <TextBox Grid.Row="2" Text="{Binding TagMessage}" Watermark="release note" FontSize="11" Padding="5,2" />
          <Button Grid.Row="1" Grid.Column="1" Content="Create tag" FontSize="11" Padding="7,3" Command="{Binding CreateTagCommand}" ToolTip.Tip="Create annotated tag at HEAD" />
          <Button Grid.Row="2" Grid.Column="1" Content="Push tags" FontSize="11" Padding="7,3" Command="{Binding PushTagsCommand}" ToolTip.Tip="Push all local tags to the configured remote" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding ExistingTagsText}" FontSize="9"
                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="6,2,6,0"
                   IsVisible="{Binding HasTagging}" />

        </Grid>
        <Expander Header="Branches" IsEnabled="{Binding CanWrite}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <ComboBox x:Name="BranchComboBox" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" HorizontalAlignment="Stretch" FontSize="11">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="git:GitBranch"><TextBlock Text="{Binding Name}" FontSize="11" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding UnmergedBranchSummary}" FontSize="10" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewBranchName}" Watermark="new branch" FontSize="11" />
              <Button Grid.Column="1" Content="Create" Command="{Binding CreateBranchCommand}" FontSize="11" />
            </Grid>
          </StackPanel>
        </Expander>
      </StackPanel>

      <!-- ── Unstaged section ──────────────────────────────────────────────── -->
      <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBgBrush}" Padding="8,5">
        <TextBlock Text="Unstaged" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      </Border>

      <ListBox Grid.Row="2"
               ItemsSource="{Binding UnstagedFiles}"
               SelectedItem="{Binding SelectedFile}"
               SelectionChanged="OnFileSelectionChanged"
               MaxHeight="120"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               x:Name="UnstagedList">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="git:GitChange">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Text="{Binding Kind}"
                         FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         MinWidth="56" />
              <TextBlock Grid.Column="1" Text="{Binding Path}"
                         FontSize="11"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Content="Stage"
                      FontSize="10" Padding="6,1"
                      Margin="4,0,0,0"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Command="{Binding DataContext.StageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- ── Staged section ───────────────────────────────────────────────── -->
      <Border Grid.Row="3" Background="{DynamicResource PanelHeaderBgBrush}" Padding="8,5" Margin="0,4,0,0">
        <TextBlock Text="Staged" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      </Border>

      <ListBox Grid.Row="4"
               ItemsSource="{Binding StagedFiles}"
               SelectedItem="{Binding SelectedFile}"
               SelectionChanged="OnFileSelectionChanged"
               MaxHeight="120"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               x:Name="StagedList">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="git:GitChange">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Text="{Binding Kind}"
                         FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         MinWidth="56" />
              <TextBlock Grid.Column="1" Text="{Binding Path}"
                         FontSize="11"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Content="Unstage"
                      FontSize="10" Padding="6,1"
                      Margin="4,0,0,0"
                      IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Command="{Binding DataContext.UnstageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- ── Commit bar + push/pull/stash actions ─────────────────────────── -->
      <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto">

        <!-- Commit bar -->
        <Border Grid.Row="0" Padding="6,6,6,0" IsEnabled="{Binding CanWrite}">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding CommitMessage}"
                     Watermark="Commit message…"
                     AcceptsReturn="True"
                     MinHeight="54"
                     FontSize="11"
                     Padding="6,4"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Grid.Column="1"
                    Content="Commit"
                    FontSize="11" Padding="8,4"
                    Margin="4,0,0,0"
                    VerticalAlignment="Stretch"
                    Command="{Binding CommitCommand}"
                    IsEnabled="{Binding CanCommit}" />
          </Grid>
        </Border>

        <!-- Stash row -->
        <Grid Grid.Row="1" IsEnabled="{Binding CanWrite}" ColumnDefinitions="Auto,Auto,*" Margin="6,4,6,6">
          <Button Grid.Column="0"
                  Content="Stash"
                  FontSize="11" Padding="8,4"
                  Margin="0,0,4,0"
                  ToolTip.Tip="Stash working-tree changes"
                  Command="{Binding StashCommand}" />
          <Button Grid.Column="1"
                  Content="Pop"
                  FontSize="11" Padding="8,4"
                  Margin="0,0,6,0"
                  ToolTip.Tip="Pop the most recent stash"
                  Command="{Binding StashPopCommand}" />
          <TextBlock Grid.Column="2"
                     FontSize="10"
                     Foreground="{DynamicResource MutedTextBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} stashed">
                <Binding Path="Stashes.Count" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Grid>

        <!-- Diff panel -->
        <views:DiffView Grid.Row="2" MinHeight="200" DataContext="{Binding Diff}" />

      </Grid>

    </Grid>
    </ScrollViewer>
  </Border>

</UserControl>
